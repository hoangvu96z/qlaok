# ================= SUPABASE DATABASE & AUTH =================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Optional: Personal Access Token (sbp_...) từ https://supabase.com/dashboard/account/tokens để chạy tự động "npm run db:migrate"
SUPABASE_ACCESS_TOKEN=
# Optional: Service Role Key cho các tác vụ Admin phía Server
SUPABASE_SERVICE_ROLE_KEY=

# ================= SECURITY & WEBHOOK SECRETS =================
SESSION_SECRET=replace-with-at-least-32-char-random-secret
# Bắt buộc cho webhook nâng cấp gói SaaS (/api/webhooks/payment). Không có mặc định; thiếu => từ chối 503.
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
# Bắt buộc để mã hóa AES-256-GCM khóa HMAC SePay của từng cửa hàng (/api/webhooks/sepay/[shopId], tối thiểu 32 ký tự).
# Không có giá trị mặc định: thiếu => tính năng lưu/xác thực SePay của cửa hàng tự động bị khóa (503).
SEPAY_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-char-random-sepay-encryption-key
# Chỉ dev/test (bị bỏ qua ở production): cho phép chủ quán giả lập webhook nâng cấp gói cho đơn của chính mình.
PAYMENT_DEV_SIMULATE=
INITIAL_SUPER_ADMIN_PASSWORD=

# ================= SAAS BILLING VIETQR (THÔNG TIN CÔNG KHAI TÀI KHOẢN NHẬN TIỀN GÓI) =================
# Danh sách tài khoản nhận tiền SaaS công khai (client-side VietQR) dạng JSON array:
# [{"bin":"970436","account":"123456789","accountName":"Qlaok Co","bankName":"VCB"}, ...]
# Bắt buộc: "bin" và "account" (chuỗi không rỗng). Tùy chọn: "accountName", "bankName" (mặc định lấy theo bin).
# Bỏ qua hoàn toàn trường "id" (tránh lỗi ID trùng/không ổn định). Thứ tự trong JSON là thứ tự hiển thị.
# Lưu ý bảo mật: Đây là thông tin công khai hiển thị trên mã QR nhận tiền (public recipient details only, không chứa secret).
# Thứ tự ưu tiên UI & fallback webhook:
# 1. NEXT_PUBLIC_SAAS_BANK_ACCOUNTS (khi có giá trị): nếu có >= 2 tài khoản, UI hiển thị bộ chọn tài khoản; nếu có 1 tài khoản, hiển thị UI như cũ (không hiện bộ chọn).
#    Nếu cấu hình sai định dạng (JSON lỗi, không phải mảng, mảng rỗng, hoặc chứa phần tử không hợp lệ), fail-closed về danh sách rỗng (ẩn QR), KHÔNG fallback về biến legacy.
# 2. Khi NEXT_PUBLIC_SAAS_BANK_ACCOUNTS vắng mặt hoặc để trống: fallback về bộ biến đơn lẻ legacy NEXT_PUBLIC_SAAS_BANK_BIN, NEXT_PUBLIC_SAAS_BANK_ACCOUNT, ...
# LƯU Ý ĐỐI SOÁT WEBHOOK: Khi server SAAS_BANK_ACCOUNTS hoặc SAAS_BANK_ACCOUNT được cấu hình tường minh, phía server có thẩm quyền tuyệt đối (authoritative) để xác thực callback thanh toán; mọi tài khoản công khai hiển thị trong NEXT_PUBLIC_SAAS_BANK_ACCOUNTS khi đó bắt buộc phải nằm trong allowlist của server, nếu không callback cho tài khoản đó sẽ bị từ chối (400 RECEIVING_ACCOUNT_MISMATCH).
NEXT_PUBLIC_SAAS_BANK_ACCOUNTS=
# BIN hoặc mã ngân hàng VietQR đơn lẻ (legacy, VD: 970422 hoặc MB). Bỏ trống => trang Billing hiện "chưa cấu hình thanh toán".
NEXT_PUBLIC_SAAS_BANK_BIN=
NEXT_PUBLIC_SAAS_BANK_ACCOUNT=
NEXT_PUBLIC_SAAS_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_SAAS_BANK_NAME=
# Danh sách số tài khoản nhận tiền SaaS (phía server) dạng JSON array của chuỗi số tài khoản, ví dụ: ["123456789","987654321"].
# Khi được đặt (chuỗi không rỗng), biến này có thẩm quyền cao nhất (authoritative) cho xác thực callback; mọi tài khoản công khai
# hiển thị trong NEXT_PUBLIC_SAAS_BANK_ACCOUNTS bắt buộc phải nằm trong allowlist này, nếu không callback cho tài khoản đó sẽ bị từ chối.
# Server chỉ parse mảng JSON gồm các chuỗi không rỗng, tự chuẩn hóa loại bỏ khoảng trắng và loại trùng giữ nguyên thứ tự xuất hiện đầu tiên.
# Nếu cấu hình sai định dạng (JSON không hợp lệ, không phải mảng, mảng rỗng, hoặc chứa phần tử không phải chuỗi/rỗng), hệ thống
# fail-closed về mảng rỗng và từ chối mọi webhook (HTTP 503 RECEIVING_ACCOUNT_NOT_CONFIGURED), TUYỆT ĐỐI KHÔNG fallback.
# Khi biến này vắng mặt hoặc để trống, server sẽ dùng SAAS_BANK_ACCOUNT (tài khoản đơn lẻ).
SAAS_BANK_ACCOUNTS=
# Tài khoản nhận tiền SaaS đơn lẻ (phía server, legacy). Khi được đặt tường minh, biến này có thẩm quyền tuyệt đối (authoritative) cho xác thực callback;
# mọi tài khoản công khai hiển thị trong NEXT_PUBLIC_SAAS_BANK_ACCOUNTS phải trùng khớp với tài khoản này, nếu không callback sẽ bị từ chối.
# Khi SAAS_BANK_ACCOUNTS vắng mặt/để trống, server dùng giá trị này; nếu cả hai biến server đều vắng mặt/để trống, server sẽ fallback về NEXT_PUBLIC_SAAS_BANK_ACCOUNTS rồi đến NEXT_PUBLIC_SAAS_BANK_ACCOUNT.
SAAS_BANK_ACCOUNT=

# ================= 9ROUTER AI SERVER (DỊCH ĐA NGÔN NGỮ & OCR MENU) =================
AI_BASE_URL=https://vunph.click/v1
AI_API_KEY=sk-your-9router-api-key
AI_MODEL=combo1
AI_VISION_MODEL=combo2

# ================= CLOUDFLARE R2 STORAGE (UPLOAD ẢNH MÓN / BÌA) =================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=qlaok-assets
NEXT_PUBLIC_R2_PUBLIC_URL=
