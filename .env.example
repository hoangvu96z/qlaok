# ================= SUPABASE DATABASE & AUTH =================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Optional: Personal Access Token (sbp_...) từ https://supabase.com/dashboard/account/tokens để chạy tự động "npm run db:migrate"
SUPABASE_ACCESS_TOKEN=
# Optional: Service Role Key cho các tác vụ Admin phía Server
SUPABASE_SERVICE_ROLE_KEY=

# ================= SECURITY & WEBHOOK SECRETS =================
SESSION_SECRET=replace-with-at-least-32-char-random-secret
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
INITIAL_SUPER_ADMIN_PASSWORD=

# ================= 9ROUTER AI SERVER (DỊCH ĐA NGÔN NGỮ & OCR MENU) =================
AI_BASE_URL=https://vunph.click/v1
AI_API_KEY=sk-your-9router-api-key
AI_MODEL=combo1
AI_VISION_MODEL=combo2

# ================= CLOUDFLARE R2 STORAGE (UPLOAD ẢNH MÓN / BÌA) =================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=qlaok-assets
NEXT_PUBLIC_R2_PUBLIC_URL=
