{
  "name": "qlaok",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "db:migrate": "node scripts/migrate-supabase.mjs",
    "db:backup": "node scripts/backup-qlaok-db.mjs",
    "db:preflight": "node scripts/preflight-demo-reset.mjs",
    "agy": "node scripts/agy-runner.mjs",
    "test:agy-runner": "node --test tests/agy-runner.test.mjs",
    "test:backup": "node --test tests/backup-qlaok-db.test.mjs",
    "test:unit": "node --experimental-strip-types --import ./tests/register-ts.mjs --test tests/unit.test.ts",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:review": "node --experimental-strip-types --import ./tests/register-ts.mjs --test --test-concurrency=1 tests/*review.test.ts tests/shop-permissions-and-rls.test.ts",
    "test:sql": "node --test tests/sql-review.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@google/genai": "^1.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "framer-motion": "^12.0.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-data-table-component": "8.12.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
