# Production API base URL (or LAN IP http://192.168.1.x:3000 in local dev)
EXPO_PUBLIC_API_URL=https://qlaok.vunph.click

# Zitadel OIDC Native App Configuration (Authorization Code + PKCE S256)
# Issuer must be HTTPS; redirect URI is fixed to qlaok://auth/callback.
# Public ID of the Qlaok Mobile Native PKCE application. Client IDs are not secrets.
EXPO_PUBLIC_ZITADEL_ISSUER_URL=https://auth.vunph.click
EXPO_PUBLIC_ZITADEL_CLIENT_ID=396886405583798275
EXPO_PUBLIC_ZITADEL_REDIRECT_URI=qlaok://auth/callback

# Self-Hosted PostgREST Base URL (defaults to EXPO_PUBLIC_API_URL -> https://qlaok.vunph.click; *.supabase.co is forbidden)
EXPO_PUBLIC_POSTGREST_URL=https://qlaok.vunph.click
