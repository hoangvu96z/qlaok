{
  "expo": {
    "name": "Qlaok",
    "slug": "qlaok-mobile-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/q-menu.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.qlaok.owner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/q-menu-adaptive.png",
        "backgroundColor": "#10b981"
      },
      "package": "vn.qlaok.owner"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/q-menu.png",
          "color": "#10b981",
          "defaultChannel": "qlaok-orders"
        }
      ]
    ]
  }
}
