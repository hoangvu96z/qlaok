{
  "expo": {
    "name": "Qlaok",
    "slug": "qlaok-mobile-owner",
    "scheme": "qlaok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/q-menu.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.qlaok.owner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/q-menu-adaptive.png",
        "backgroundColor": "#10b981"
      },
      "package": "vn.qlaok.owner"
    },
    "extra": {
      "eas": {
        "projectId": "4d683d00-5ac1-4665-8f3f-618531d72707"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/q-menu.png",
          "color": "#10b981",
          "defaultChannel": "qlaok-orders"
        }
      ]
    ],
    "owner": "hoangvu96z"
  }
}
