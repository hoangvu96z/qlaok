[Unit]
Description=Qlaok self-hosted PostgreSQL backup
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/qlaok/postgres-backup.env
WorkingDirectory=/var/www/qlaok.vunph.click
ExecStart=/usr/bin/node /var/www/qlaok.vunph.click/scripts/backup-self-hosted-postgres.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/qlaok/postgres
